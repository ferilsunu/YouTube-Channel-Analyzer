<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{#if data.channel.title}}{{data.channel.title}} • YouTube Intelligence & Analytics{{else}}YouTube Channel Analyzer • Intelligence Platform{{/if}}</title>
  
  <meta name="description" content="Advanced YouTube Channel Intelligence, CPM Revenue Estimator, Engagement Benchmarking, and SEO Analytics by Feril Sunu">
  <meta name="theme-color" content="#ffffff">

  <!-- Local Fonts & App Styles -->
  <link rel="stylesheet" href="/assets/css/style.css?v=3.5.0">
  <link rel="icon" type="image/png" href="/assets/images/Logo.png">
</head>
<body>

  <!-- App Header -->
  <header class="app-header">
    <div class="header-inner">
      <div class="brand-group">
        <div class="brand-logo-icon" title="YouTube Intelligence">
          <svg class="brand-logo-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
            <polygon points="10 15 15 12 10 9 10 15" fill="currentColor"></polygon>
          </svg>
        </div>
        <div class="brand-titles">
          <a href="/" class="brand-name">YOUTUBE ANALYZER</a>
          <span class="brand-sub">CHANNEL INTELLIGENCE</span>
        </div>
      </div>

      <!-- Live Search Bar -->
      <div class="header-search-wrap">
        <form id="global-search-form" action="/analyze" method="GET">
          <div class="search-input-box">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="header-search-input" name="channel" placeholder="Search channel name, @handle, or URL..." value="{{searchQuery}}" autocomplete="off" spellcheck="false">
            <button type="submit" class="search-submit-btn" aria-label="Analyze Channel">
              <span>Analyze</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Quick Actions -->
      <div class="header-actions">
        <a href="https://github.com/ferilsunu/YouTube-Channel-Analyzer" target="_blank" rel="noopener" class="glass-btn icon-btn" title="View Source on GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a href="https://ferilsunu.com" target="_blank" rel="noopener" class="glass-btn pill-btn">
          <span>Portfolio</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="main-dashboard-wrap">
    {{{body}}}
  </main>

  <!-- Video Player Modal -->
  <div id="video-modal-backdrop" class="modal-backdrop">
    <div class="modal-container">
      <div class="modal-header">
        <h3 id="modal-video-title" class="modal-title">Video Preview</h3>
        <button type="button" id="modal-close-btn" class="modal-close-btn" aria-label="Close video player">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="video-iframe-wrap">
          <iframe id="modal-video-iframe" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast-notify" class="toast-popup">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="9 12 11 14 15 10"></polyline>
    </svg>
    <span id="toast-message">Report copied to clipboard!</span>
  </div>

  <!-- Lucide Icons Engine -->
  <script src="/assets/js/lucide.min.js"></script>

  <!-- App Script -->
  <script src="/assets/js/dashboard.js?v=3.5.0"></script>
</body>
</html>