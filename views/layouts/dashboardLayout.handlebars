<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{#if data.channel.title}}{{data.channel.title}} • YouTube Intelligence & Analytics{{else}}YouTube Channel Analyzer • Intelligence Platform{{/if}}</title>
  
  <meta name="description" content="Advanced YouTube Channel Intelligence, CPM Revenue Estimator, Engagement Benchmarking, and SEO Analytics by Feril Sunu">
  <meta name="theme-color" content="#ffffff">

  <!-- Local Fonts & App Styles -->
  <link rel="stylesheet" href="/assets/css/style.css?v=3.1.0">
  <link rel="icon" type="image/png" href="/assets/images/Logo.png">
</head>
<body>

  <!-- App Header -->
  <header class="app-header">
    <div class="header-inner">
      <div class="brand-group">
        <div class="brand-logo-icon" title="YouTube Intelligence">
          <svg class="brand-logo-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
            <polygon points="10 15 15 12 10 9 10 15" fill="currentColor"></polygon>
          </svg>
        </div>
        <div class="brand-titles">
          <a href="/" class="brand-name">YOUTUBE ANALYZER</a>
          <span class="brand-sub">CHANNEL INTELLIGENCE</span>
        </div>
      </div>

      <!-- Live Search Bar -->
      <div class="header-search-wrap">
        <form id="global-search-form" action="/analyze" method="GET">
          <div class="search-input-box">
            <i data-lucide="search" class="search-icon"></i>
            <input type="text" id="header-search-input" name="channel" placeholder="Search channel name, @handle, or URL..." value="{{searchQuery}}" autocomplete="off" spellcheck="false">
            <button type="submit" class="search-submit-btn" aria-label="Analyze Channel">
              <span>Analyze</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Quick Actions -->
      <div class="header-actions">
        <a href="https://github.com/ferilsunu/YouTube-Channel-Analyzer" target="_blank" rel="noopener" class="glass-btn icon-btn" title="View Source on GitHub">
          <i data-lucide="github" style="width: 17px; height: 17px;"></i>
        </a>
        <a href="https://ferilsunu.com" target="_blank" rel="noopener" class="glass-btn pill-btn">
          <span>Portfolio</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="main-dashboard-wrap">
    {{{body}}}
  </main>

  <!-- Video Player Modal -->
  <div id="video-modal-backdrop" class="modal-backdrop">
    <div class="modal-container">
      <div class="modal-header">
        <h3 id="modal-video-title" class="modal-title">Video Preview</h3>
        <button type="button" id="modal-close-btn" class="modal-close-btn" aria-label="Close video player">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="video-iframe-wrap">
          <iframe id="modal-video-iframe" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast-notify" class="toast-popup">
    <i data-lucide="check-circle-2" style="width: 16px; height: 16px; color: #10b981;"></i>
    <span id="toast-message">Report copied to clipboard!</span>
  </div>

  <!-- Lucide Icons Engine -->
  <script src="/assets/js/lucide.min.js"></script>

  <!-- App Script -->
  <script src="/assets/js/dashboard.js?v=3.1.0"></script>
</body>
</html>